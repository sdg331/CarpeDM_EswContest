# ReliefCheck runtime settings.
# Copy to .env on Raspberry Pi if you use a shell wrapper. Do not commit real secrets.

RELIEFCHECK_DB=/home/pi/reliefcheck/data/reliefcheck.db
RELIEFCHECK_HOST=127.0.0.1
RELIEFCHECK_PORT=8008

# screen: save receipt text files for development
# cups: print through lp/CUPS
# escpos: print through python-escpos USB backend
RELIEFCHECK_PRINTER=screen
RELIEFCHECK_RECEIPT_DIR=/home/pi/reliefcheck/data/receipts
RELIEFCHECK_CUPS_PRINTER=
RELIEFCHECK_ESCPOS_VENDOR=
RELIEFCHECK_ESCPOS_PRODUCT=

# pyscard reader names. Leave blank until lsusb/PCSC reader names are verified.
RELIEFCHECK_NFC_MODE=manual
RELIEFCHECK_NFC_HOUSEHOLD_READER=
RELIEFCHECK_NFC_ITEM_READER=

# simulated: UI checkbox / manual API flag
# qr-camera: OpenCV QR detector from a camera device index
RELIEFCHECK_VISION_MODE=simulated
RELIEFCHECK_CAMERA_INDEX=0

# Remote admin actions require this header when the server is bound beyond localhost:
# X-Admin-Token: <value>
RELIEFCHECK_ADMIN_TOKEN=
RELIEFCHECK_ALLOW_DEMO_RESET=1

